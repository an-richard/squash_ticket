# URL de votre instance Squash TM (sans slash final)
SQUASH_BASE_URL=https://squashtm.groupebovis.local

# Token JWT Squash TM (même valeur que VITE_SQUASH_TOKEN dans le frontend)
SQUASH_TOKEN=eyJ...

# URL interne du backend tool-bug-tracker (nom du service Docker)
BUG_TRACKER_URL=http://backend:3000

# ID du statut "Nouveau" dans la base de données bug tracker
DEFAULT_STATUS_ID=3

# ID de l'importance par défaut (ex: "Normal")
DEFAULT_IMPORTANCE_ID=1

# Intervalle de polling en secondes (120 = toutes les 2 minutes)
POLL_INTERVAL_SECONDS=120
